---
const { title } = Astro.props
---

<article class='card-ns'>
  <h2 class='text-[16px] font-bold mb-4'>{title}</h2>
  <div>
    <slot />
  </div>
</article>

<style is:global>
  .card-ns {
    background-color: white;
    padding: 24px;
    border: 1px solid #e2e8f0;
    font-size: 14px;
    box-shadow: 0 0 2px rgba(0, 0, 0, 0.1);
  }
</style>
