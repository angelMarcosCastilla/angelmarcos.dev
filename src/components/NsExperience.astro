---
import { EXPERIENCIES_NETSUITE } from '@/data/experiencies'
---

<div class='mt-8'>
  <ol class='relative border-s border-nsPrimary ml-3'>
    {
      EXPERIENCIES_NETSUITE.map((experiencie) => (
        <li class='mb-10 ms-4'>
          <div class='absolute w-3 h-3 uppercase rounded-full mt-1.5 -start-1.5 border border-input bg-nsPrimaryHover' />
          <time class='mb-1 text-xs font-normal leading-none '>{experiencie.time}</time>
          <h3 class='text-base font-semibold  mb-2 '>
            {experiencie.role} − {experiencie.company}{' '}
          </h3>
          <p class='mb-4 text-sm font-normal  text-pretty max-w-[900px]'>
            {experiencie.description}
          </p>
        </li>
      ))
    }
  </ol>
</div>
